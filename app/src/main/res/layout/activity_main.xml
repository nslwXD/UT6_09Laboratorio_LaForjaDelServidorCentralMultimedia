<?xml version="1.0" encoding="utf-8"?>
<!-- consola de mando: formato vertical con selector arriba,
     reproductor en el centro y estado de la conexion abajo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- cabecera: selector desplegable de canales -->
    <Spinner
        android:id="@+id/spCanales"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- seccion media: playerview muestra el video de exoplayer.
         height 0dp + weight 1 = ocupa todo el hueco entre el spinner y el texto -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/pvMonitor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- zona inferior: estado de la conexion -->
    <TextView
        android:id="@+id/tvEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textSize="18sp" />

</LinearLayout>
